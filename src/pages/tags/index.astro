---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isPostId, postTags } from '../../utils/posts';

const posts = (await getCollection('posts')).filter((post) => isPostId(post.id) && !post.id.startsWith('en/') && !post.data.draft);
const tags = [...new Set(posts.flatMap((post) => postTags(post)))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<Base active="tags" title="专题">
  <section class="taxonomy-page" aria-label="专题">
    <div class="tag-cloud">
      {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}<span>{posts.filter((post) => postTags(post).includes(tag)).length}</span></a>)}
    </div>
  </section>
</Base>
