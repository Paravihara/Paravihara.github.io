---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { excerpt, isEnglishPost, isPostId, postPath, readTime, sortPosts } from '../../utils/posts';

const posts = sortPosts((await getCollection('posts')).filter((post) => isPostId(post.id) && isEnglishPost(post.id) && !post.data.draft));
const formatDate = (date?: Date) => date ? date.toISOString().slice(0, 10) : 'Undated';
const groups = Array.from({ length: Math.ceil(posts.length / 2) }, (_, index) => posts.slice(index * 2, index * 2 + 2));
---

<Base title="Pārāvihāra">
  <section class="feed" aria-label="Article list">
    {groups.map((group) => (
      <section class="post-group">
        <div class="decorative-line" aria-hidden="true"></div>
        <ul class="post-list">
          {group.map((post) => (
            <li class="post-card">
              <h3>
                <a class="post-card__title" href={postPath(post.id, true)}>{post.data.title}</a>
                {post.data.pin && <span class="pin" aria-label="Pinned">
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M23.7,8.1l-2.2-2.2-3.3-3.3L15.9.3C9,6.4,6.5,7,.4,7.5l6.4,6.4,1,1-6.5,6.9.9.9,6.9-6.5,1,1,6.4,6.4c.5-6.1,1.1-8.6,7.2-15.5ZM7.9,12.7l-4.4-4.4c4.1-.5,5.9-1,12-6l1.4,1.4,3.3,3.3,1.4,1.4c-5,6.1-5.5,7.9-6,12l-4.4-4.4-3.3-3.3Z"></path></svg>
                </span>}
              </h3>
              <p class="post-card__meta"><time datetime={post.data.published?.toISOString()}>{formatDate(post.data.published)}</time><span>· {readTime(post.body ?? '', true)} min</span></p>
              <p class="post-card__excerpt">{post.data.description ?? excerpt(post.body ?? '')}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</Base>
