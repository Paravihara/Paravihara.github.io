---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { isEnglishPost, isPostId, postTags } from '../../../utils/posts';

const posts = (await getCollection('posts')).filter((post) => isPostId(post.id) && isEnglishPost(post.id) && !post.data.draft);
const tags = [...new Set(posts.flatMap((post) => postTags(post)))].sort((a, b) => a.localeCompare(b));
---

<Base active="tags" title="Tags">
  <section class="taxonomy-page" aria-label="Tags">
    <div class="tag-cloud">
      {tags.map((tag) => <a href={`/en/tags/${encodeURIComponent(tag)}/`}>#{tag}<span>{posts.filter((post) => postTags(post).includes(tag)).length}</span></a>)}
    </div>
  </section>
</Base>
